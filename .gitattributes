# Enforce LF endings and UTF-8 across all platforms
* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary files
*.skill binary
*.vsdx binary
*.vssx binary
*.pdf binary
*.png binary
*.jpg binary
*.bin binary
*.var binary
*.uprj binary
